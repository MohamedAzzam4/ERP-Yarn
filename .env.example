# ERP-Yarn environment variable example
#
# WP-00-02 scope: this file lists ONLY the five DEC-057 standardized names
# with empty values. Real values must never be committed.
#
# Contract references:
#   - docs/02_decision_log_and_scope.md DEC-057 (key/environment model)
#   - docs/contracts/01_technical_architecture_and_deployment_contract.md
#     §Environment Variables (binding categories)
#   - docs/contracts/13_work_packages.md WP-00-02 (".env.example uses only
#     the DEC-057 variable names with empty values")
#
# Legacy `NEXT_PUBLIC_SUPABASE_ANON_KEY` and `SUPABASE_SERVICE_ROLE_KEY` are
# FORBIDDEN unless a future reviewed compatibility decision explicitly
# authorizes them. Do not add them here.
#
# DATABASE_MIGRATION_URL is intentionally NOT listed in WP-00-02.
# Contract 01 §Environment Variables includes a "server-only
# migration/administration" category containing DATABASE_MIGRATION_URL, but
# WP-00-02's implementation-note wording says ".env.example uses only the
# DEC-057 variable names". This ambiguity is recorded as
# "Unresolved / requires owner decision" in the WP-00-02 completion report
# and deferred to the first package that actually performs migrations
# (WP-00-03A at earliest). WP-00-02 itself does not run migrations and does
# not need DATABASE_MIGRATION_URL.

# Browser-safe Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe publishable key (new publishable/secret key model)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key. NEVER prefix with NEXT_PUBLIC_.
# NEVER import in client code. Bypasses RLS; server-only.
SUPABASE_SECRET_KEY=

# Server-only pooled transaction string for postgres.js runtime queries.
# Must use the Supabase transaction pooler. postgres.js must be configured
# with `prepare: false`.
DATABASE_URL=

# Non-secret project metadata. Identifies the project; not browser-exposed
# unless a later contract requires it.
SUPABASE_PROJECT_REF=

# Server-only bootstrap secret for one-time dev/demo Owner creation (DEC-074).
# NEVER prefix with NEXT_PUBLIC_. NEVER commit the real value.
# Only needed for the /api/bootstrap route. Optional for normal operation.
OWNER_BOOTSTRAP_SECRET=
